-- TalkAI.lua (CLIENT-SIDE TRIGGER AI)

local TalkAI = {}

TalkAI.NPCName = "Verity"

TalkAI.Memory = {
	lastMessage = "",
	flags = {}
}

-- =========================
-- TIME HELPERS
-- =========================
local function minretsec(min)
	return min * 60
end

-- global event flag
local somethingiscoming = false

task.spawn(function()
	while task.wait(1) do
		-- example trigger: 10 minutes
		if os.clock() >= 10 * 60 then
			somethingiscoming = true
		end
	end
end)

-- =========================
-- MESSAGE QUEUE SYSTEM
-- =========================
TalkAI.MessageQueue = {}

function TalkAI:Say(text, duration)
	table.insert(self.MessageQueue, {
		text = text,
		time = duration or 2
	})
end

function TalkAI:GetNextMessage()
	return table.remove(self.MessageQueue, 1)
end

-- =========================
-- TRIGGERS STORAGE
-- =========================
TalkAI.Triggers = {
	time = {},
	condition = {}
}

function TalkAI:AddTimedMessage(delaySeconds, message)
	table.insert(self.Triggers.time, {
		runAt = os.clock() + delaySeconds,
		message = message,
		used = false
	})
end

function TalkAI:AddConditionMessage(conditionFunc, message, repeatable)
	table.insert(self.Triggers.condition, {
		check = conditionFunc,
		message = message,
		repeatable = repeatable or false,
		fired = false
	})
end

-- =========================
-- CHAT REPLY SYSTEM
-- =========================
local function simpleReply(msg, somethingiscoming)
	msg = string.lower(msg)

	-- HELLO
	if msg:find("hello") or msg:find("hi") then
		if somethingiscoming then
			return "Something is coming in 3 days."
		end
		return "Hey."

	-- HELP
	elseif msg:find("help") then
		if somethingiscoming then
			return "Something is coming in 3 days."
		end
		return "What do you need?"

	-- WHO ARE YOU
	elseif msg:find("who are you") then
		if somethingiscoming then
			return "Something is coming in 3 days."
		end
		return "I'm " .. TalkAI.NPCName .. "."

	-- EASTER EGG
	elseif msg:find("balls") then
		if somethingiscoming then
			return "Something is coming in 3 days."
		end
		return "Bruh (you found an easter egg with Verity!)"

	-- NAME
	elseif msg:find("what's your name") or msg:find("what is your name") then
		if somethingiscoming then
			return "Something is coming in 3 days."
		end
		return "Hello! My name's Verity. I know everything."

	-- HOW ARE YOU
	elseif msg:find("what's up verity") or msg:find("how's life") then
		if somethingiscoming then
			return "Something is coming in 3 days."
		end
		return "Fine."

	end

	return "I don't know about that."
end

function TalkAI:Reply(playerMessage)
	self.Memory.lastMessage = playerMessage
	return simpleReply(playerMessage, somethingiscoming)
end

-- =========================
-- UPDATE LOOP
-- =========================
function TalkAI:Update(player)

	-- TIME TRIGGERS
	for _, t in ipairs(self.Triggers.time) do
		if not t.used and os.clock() >= t.runAt then
			self:Say(t.message, 3)
			t.used = true
		end
	end

	-- CONDITION TRIGGERS
	for _, c in ipairs(self.Triggers.condition) do
		if c.check(player) then
			if c.repeatable then
				self:Say(c.message, 3)
			elseif not c.fired then
				self:Say(c.message, 3)
				c.fired = true
			end
		else
			if c.repeatable then
				c.fired = false
			end
		end
	end
end

return TalkAI
